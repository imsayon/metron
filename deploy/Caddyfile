{
  admin off
}

:8080 {
  encode gzip

  header {
    -Server
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    X-Frame-Options "DENY"
    Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval';"
  }

  @api path /api/* /v1/* /healthz /metrics /ws*
  reverse_proxy @api api:8000
  reverse_proxy ui:3000
}
